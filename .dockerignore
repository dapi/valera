# Only production runtime files enter the remote build context.
**
!Gemfile
!Gemfile.lock
!Rakefile
!config.ru
!.semver
!app/
!app/**
!bin/
!bin/**
!config/
!config/**
!data/
!data/**
!db/
!db/**
!lib/
!lib/**
!public/
!public/**
!vendor/
!vendor/**
!log/
!log/.keep
!tmp/
!tmp/.keep
!storage/
!storage/.keep

# Machine credentials and development artifacts are never runtime inputs.
config/master.key
config/credentials/*.key
config/environments/*.backup
config/deploy*.yml
lib/tasks/dev/
vendor/bundle/
app/assets/builds/*
!app/assets/builds/.keep
public/assets/
db/*.sqlite3*
