doctype html
html lang="ru"
  head
    title = ApplicationConfig.app_name
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="referrer" content="no-referrer"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload'
    = javascript_importmap_tags
  body.bg-gray-100.min-h-screen.flex.items-center.justify-center
    main.w-full.max-w-lg.p-6
      .bg-white.rounded-xl.shadow.p-8
        h1.text-2xl.font-bold.text-gray-800.mb-6 = ApplicationConfig.app_name
        = render 'tenants/shared/flash'
        - if @errors.present?
          .mb-4.rounded.bg-red-50.p-4.text-red-700 role="alert"
            - @errors.each do |error|
              p = error
        = yield
