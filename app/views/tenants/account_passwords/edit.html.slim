.max-w-lg.mx-auto.bg-white.rounded-lg.shadow.p-6
  h1.text-2xl.font-semibold.mb-4 Смена пароля
  p.text-gray-600.mb-6 Новый пароль будет действовать во всех ваших аккаунтах Супер Валеры.
  - if @errors.present?
    .mb-4.bg-red-50.text-red-700.p-4.rounded role="alert"
      - @errors.each do |error|
        p = error
  = form_with url: tenant_account_password_path, method: :patch, class: 'space-y-5', data: { turbo: false } do |f|
    - if current_user.password_digest.present?
      = f.label :current_password, 'Текущий пароль', class: 'block font-medium'
      = f.password_field :current_password, required: true, autocomplete: 'current-password', class: 'w-full border rounded-lg px-3 py-2'
    = f.label :password, 'Новый пароль (не короче 8 символов)', class: 'block font-medium'
    = f.password_field :password, required: true, minlength: 8, autocomplete: 'new-password', class: 'w-full border rounded-lg px-3 py-2'
    = f.label :password_confirmation, 'Повторите новый пароль', class: 'block font-medium'
    = f.password_field :password_confirmation, required: true, minlength: 8, autocomplete: 'new-password', class: 'w-full border rounded-lg px-3 py-2'
    = f.submit 'Изменить пароль', class: 'w-full bg-blue-600 text-white rounded-lg px-4 py-3 cursor-pointer'
  = link_to 'Не помню текущий пароль', new_password_reset_url(**ApplicationConfig.default_url_options), class: 'block text-center text-blue-600 mt-6'
